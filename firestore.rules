rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsEmail(email) {
      return signedIn()
        && request.auth.token.email != null
        && request.auth.token.email.lower() == email.lower();
    }

    // User profile and reward data. Passwords must never be stored here.
    match /users/{email} {
      allow read: if ownsEmail(email);
      allow create, update: if ownsEmail(email)
        && request.resource.data.email == email.lower()
        && !('password' in request.resource.data);
      allow delete: if false;

      // Order history belongs only to this user. Creation is allowed once;
      // later updates may only append/change Firebase photo URLs.
      match /orders/{orderId} {
        allow read: if ownsEmail(email);
        allow create: if ownsEmail(email)
          && request.resource.data.ownerEmail == email.lower();
        allow update: if ownsEmail(email)
          && resource.data.ownerEmail == email.lower()
          && request.resource.data.ownerEmail == email.lower()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['photoUrls']);
        allow delete: if false;
      }
    }

    // Each signed-in user can access only their own cart.
    match /carts/{email}/items/{itemId} {
      allow read, create, update, delete: if ownsEmail(email);
    }

    // Restaurant data is visible to guests. Authenticated clients may perform
    // the app's one-time TheMealDB-to-Firestore seed, but cannot delete it.
    match /vendors/{vendorId} {
      allow read: if true;
      allow create, update: if signedIn()
        && request.resource.data.keys().hasAll([
          'name', 'displayName', 'status', 'category', 'thumbnailUrl'
        ]);
      allow delete: if false;

      match /menuItems/{itemId} {
        allow read: if true;
        allow create, update: if signedIn()
          && request.resource.data.keys().hasAll([
            'name', 'price', 'description', 'thumbnailUrl', 'vendorName'
          ]);
        allow delete: if false;
      }
    }

    // Everything not explicitly matched above is denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
